# =============================================================================
# FlowForge Backend — Variables d'environnement
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS committer le fichier .env en git.
# Ce fichier .env.example ne doit contenir AUCUNE valeur secrète réelle.
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DONNÉES (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://flowforge:changeme@localhost:5432/flowforge

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# Format: redis://HOST:PORT/DB_NUMBER
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# AUTHENTIFICATION JWT
# -----------------------------------------------------------------------------
# Clé secrète pour signer les tokens JWT.
# Générer avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-replace-with-a-strong-random-secret

# Algorithme JWT (HS256 recommandé)
ALGORITHM=HS256

# Durée de vie des access tokens en minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# CHIFFREMENT DES CREDENTIALS (Fernet / AES-128)
# -----------------------------------------------------------------------------
# Clé Fernet pour chiffrer les credentials en base de données.
# Générer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# -----------------------------------------------------------------------------
# INTÉGRATION GOOGLE / GMAIL (OAuth 2.0)
# -----------------------------------------------------------------------------
# Obtenir sur: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=votre_client_id_ic
GOOGLE_CLIENT_SECRET=votre_client_secret_ici
# URL de callback OAuth (doit correspondre à ce qui est enregistré dans Google Cloud)
GOOGLE_REDIRECT_URI=http://localhost:8005/api/v1/integrations/google/callback
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# INTÉGRATION TELEGRAM (Bot API)
# -----------------------------------------------------------------------------
# Obtenir via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# SERVICE ML (flowforge-ml)
# -----------------------------------------------------------------------------
# FlowForge-ML inference API URL (same machine by default: localhost:8001)
FLOWFORGE_ML_URL=http://localhost:8001

# Ollama Cloud chat model (the API key is configured only in the local .env)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b

# -----------------------------------------------------------------------------
# CONFIGURATION APPLICATIVE
# -----------------------------------------------------------------------------
# Niveau de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Ne jamais utiliser DEBUG en production (risque de fuite de secrets)
LOG_LEVEL=INFO

# Nombre de workers Uvicorn (pour la production)
WORKERS_COUNT=1

# Environnement: development, staging, production
ENVIRONMENT=development

# =============================================================================
# NOTES DE SÉCURITÉ
# =============================================================================
# - SECRET_KEY et ENCRYPTION_KEY doivent être différentes et uniques par environnement.
# - En production, utiliser un gestionnaire de secrets (Vault, AWS Secrets Manager).
# - Le fichier .env ne doit jamais être committé en git (.gitignore).
# - Rotation des clés: prévoir une procédure de re-chiffrement des credentials.
# =============================================================================
